# Copies runtime dependencies of an app next to its executable.
# Usage: cmake -DERA_RUNTIME_MANIFEST=<manifest generated by _era_finalize_app> -P deploy_runtime.cmake

if(NOT ERA_RUNTIME_MANIFEST OR NOT EXISTS "${ERA_RUNTIME_MANIFEST}")
    message(FATAL_ERROR "Runtime manifest '${ERA_RUNTIME_MANIFEST}' not found. Re-run CMake configuration.")
endif()

include("${ERA_RUNTIME_MANIFEST}")

file(MAKE_DIRECTORY "${ERA_RUNTIME_DESTINATION}")

# file(COPY) preserves timestamps and skips files that are already up to date.
foreach(runtime_file IN LISTS ERA_RUNTIME_FILES)
    if(runtime_file)
        file(COPY "${runtime_file}" DESTINATION "${ERA_RUNTIME_DESTINATION}")
    endif()
endforeach()

foreach(runtime_dir IN LISTS ERA_RUNTIME_DIRS)
    if(runtime_dir)
        file(COPY "${runtime_dir}/" DESTINATION "${ERA_RUNTIME_DESTINATION}")
    endif()
endforeach()
