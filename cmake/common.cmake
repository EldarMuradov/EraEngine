# Era Engine build helpers.
#
#   era_module(<name> [EXPORT_DEFINE <define>] [PUBLIC <deps...>] [PRIVATE <deps...>])
#       Shared library built from <current dir>/src. Its output directory contains only the module's
#       own binaries; nothing is copied into it.
#
#   era_app(<name> [DEPENDS <deps...>])
#       Executable built from <current dir>/src. All runtime dependencies (module DLLs, third-party
#       DLLs, engine runtime files) are collected transitively and deployed next to the executable.
#
#   era_add_runtime(<target> [FILES <files...>] [DIRS <dirs...>])
#       Declares files/directories that must be deployed next to every app that (transitively)
#       links <target>. Generator expressions are allowed.

include_guard(GLOBAL)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} /MP /arch:AVX2 /Zi /Gy /GF /EHsc")

# Third-party prebuilt binaries exist only for Debug and Release; other configs use Release ones.
set(ERA_THIRDPARTY_CONFIG "$<IF:$<CONFIG:Debug>,Debug,Release>")


function(era_add_runtime target)
    cmake_parse_arguments(ARG "" "" "FILES;DIRS" ${ARGN})
    if(ARG_FILES)
        set_property(TARGET ${target} APPEND PROPERTY ERA_RUNTIME_FILES ${ARG_FILES})
    endif()
    if(ARG_DIRS)
        set_property(TARGET ${target} APPEND PROPERTY ERA_RUNTIME_DIRS ${ARG_DIRS})
    endif()
endfunction()

# Collects all targets reachable from <target> through LINK_LIBRARIES / INTERFACE_LINK_LIBRARIES.
function(_era_collect_link_closure target out_var)
    set(visited "")
    set(pending ${target})
    while(pending)
        list(POP_FRONT pending current)
        if(current IN_LIST visited)
            continue()
        endif()
        list(APPEND visited ${current})

        get_target_property(type ${current} TYPE)
        get_target_property(imported ${current} IMPORTED)
        set(links "")
        if(NOT imported AND NOT type STREQUAL "INTERFACE_LIBRARY")
            get_target_property(links ${current} LINK_LIBRARIES)
        endif()
        get_target_property(interface_links ${current} INTERFACE_LINK_LIBRARIES)

        foreach(item IN LISTS links interface_links)
            if(item MATCHES "^\\$<LINK_ONLY:(.+)>$")
                set(item "${CMAKE_MATCH_1}")
            endif()
            if(TARGET "${item}")
                get_target_property(aliased ${item} ALIASED_TARGET)
                if(aliased)
                    set(item ${aliased})
                endif()
                list(APPEND pending ${item})
            endif()
        endforeach()
    endwhile()
    set(${out_var} ${visited} PARENT_SCOPE)
endfunction()

# Deferred to the end of the top-level CMakeLists, when every target is declared.
function(_era_finalize_app app)
    _era_collect_link_closure(${app} dependencies)

    set(runtime_files "")
    set(runtime_dirs "")
    set(built_libraries "")
    foreach(dependency IN LISTS dependencies)
        if(dependency STREQUAL app)
            continue()
        endif()

        get_target_property(type ${dependency} TYPE)
        get_target_property(imported ${dependency} IMPORTED)
        if(type STREQUAL "SHARED_LIBRARY")
            list(APPEND runtime_files "$<TARGET_FILE:${dependency}>")
            if(NOT imported)
                list(APPEND built_libraries ${dependency})
            endif()
        endif()

        get_target_property(files ${dependency} ERA_RUNTIME_FILES)
        if(files)
            list(APPEND runtime_files ${files})
        endif()
        get_target_property(dirs ${dependency} ERA_RUNTIME_DIRS)
        if(dirs)
            list(APPEND runtime_dirs ${dirs})
        endif()
    endforeach()

    list(REMOVE_DUPLICATES runtime_files)
    list(REMOVE_DUPLICATES runtime_dirs)
    list(JOIN runtime_files "\"\n    \"" runtime_files_content)
    list(JOIN runtime_dirs "\"\n    \"" runtime_dirs_content)

    set(manifest "${CMAKE_BINARY_DIR}/runtime/${app}_$<CONFIG>.cmake")
    file(GENERATE OUTPUT "${manifest}" CONTENT
"# Generated by Era Engine CMake. Runtime dependencies of ${app} ($<CONFIG>).
set(ERA_RUNTIME_DESTINATION \"$<TARGET_FILE_DIR:${app}>\")
set(ERA_RUNTIME_FILES
    \"${runtime_files_content}\")
set(ERA_RUNTIME_DIRS
    \"${runtime_dirs_content}\")
")

    # Runs on every build of the app, so module DLLs are refreshed even when the exe is not relinked.
    # file(COPY) skips files whose timestamps already match, so an up-to-date deploy is cheap.
    add_custom_target(${app}_runtime
        COMMAND ${CMAKE_COMMAND} "-DERA_RUNTIME_MANIFEST=${manifest}" -P "${ERA_ENGINE_PATH}/cmake/scripts/deploy_runtime.cmake"
        COMMENT "Deploying runtime dependencies of ${app}"
        VERBATIM)
    if(built_libraries)
        add_dependencies(${app}_runtime ${built_libraries})
    endif()
    add_dependencies(${app} ${app}_runtime)
    set_target_properties(${app}_runtime PROPERTIES FOLDER deployment)
endfunction()

