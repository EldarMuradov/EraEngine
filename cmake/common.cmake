# ------------------------------------------------------------------------------------------------
# Modules and apps
# ------------------------------------------------------------------------------------------------

function(_era_glob_sources out_var)
    file(GLOB_RECURSE sources CONFIGURE_DEPENDS
        ${CMAKE_CURRENT_SOURCE_DIR}/src/*.cpp
        ${CMAKE_CURRENT_SOURCE_DIR}/src/*.h
        ${CMAKE_CURRENT_SOURCE_DIR}/src/*.hpp)
    source_group(TREE ${CMAKE_CURRENT_SOURCE_DIR} FILES ${sources})
    set(${out_var} ${sources} PARENT_SCOPE)
endfunction()

function(era_module name)
    cmake_parse_arguments(ARG "" "EXPORT_DEFINE" "PUBLIC;PRIVATE" ${ARGN})
    message(STATUS "Era module: ${name}")

    _era_glob_sources(sources)
    add_library(${name} SHARED ${sources})
    target_include_directories(${name} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/src)

    if(NOT ARG_EXPORT_DEFINE)
        string(TOUPPER "ERA_${name}" ARG_EXPORT_DEFINE)
    endif()
    target_compile_definitions(${name} PRIVATE ${ARG_EXPORT_DEFINE})

    target_link_libraries(${name} PRIVATE era_common)
    if(ARG_PUBLIC)
        target_link_libraries(${name} PUBLIC ${ARG_PUBLIC})
    endif()
    if(ARG_PRIVATE)
        target_link_libraries(${name} PRIVATE ${ARG_PRIVATE})
    endif()

    set_target_properties(${name} PROPERTIES FOLDER modules)
endfunction()

function(era_app name)
    cmake_parse_arguments(ARG "" "" "DEPENDS" ${ARGN})
    message(STATUS "Era app: ${name}")

    _era_glob_sources(sources)
    add_executable(${name} ${sources})
    target_include_directories(${name} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/src)
    target_link_libraries(${name} PRIVATE era_common ${ARG_DEPENDS})

    set_target_properties(${name} PROPERTIES FOLDER apps)

    # DEFER evaluates its arguments when the call runs, so bake the name in now.
    cmake_language(EVAL CODE "cmake_language(DEFER DIRECTORY [[${CMAKE_SOURCE_DIR}]] CALL _era_finalize_app [[${name}]])")
endfunction()

# Puts third-party targets into a separate folder of the generated solution.
function(era_thirdparty_folder)
    foreach(target IN LISTS ARGN)
        if(TARGET ${target})
            set_target_properties(${target} PROPERTIES FOLDER thirdparty)
        endif()
    endforeach()
endfunction()
